# ---- Database ----
# MongoDB Atlas connection string (include the database name at the end)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/booleanmaths

# ---- Redis (docker compose up -d) ----
REDIS_URL=redis://localhost:6379

# ---- API ----
PORT=4000
API_BASE=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---- Slack dispatch behaviour ----
# true  -> worker posts to the local mock endpoint (/api/mock-slack-webhook)
# false -> worker posts to each client's real Slack webhook URL
USE_MOCK_SLACK=true
# Fraction of mock requests answered with 429 + Retry-After: 3 (0 disables)
MOCK_429_RATE=0.2
MOCK_RETRY_AFTER_SECONDS=3

# ---- Scheduler ----
ENABLE_CRON=false
CRON_SCHEDULE=0 9 * * *
CRON_TZ=Asia/Kolkata

# ---- Seed data: 5 Slack Incoming Webhook URLs ----
SLACK_WEBHOOK_1=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_2=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_3=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_4=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_5=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
