{
  "name": "booleanmaths-slack-dispatcher",
  "private": true,
  "version": "1.0.0",
  "description": "Rate-limited Slack report dispatcher — MERN + Redis (BullMQ)",
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "npm run dev --workspace server",
    "worker": "npm run worker --workspace server",
    "web": "npm run dev --workspace client",
    "seed": "npm run seed --workspace server",
    "verify:aggregation": "npm run verify:aggregation --workspace server",
    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down",
    "build": "npm run build --workspace server && npm run build --workspace client"
  },
  "engines": { "node": ">=20 <25" }
}
